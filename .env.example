# Copia este archivo y renombra la copia como .env
# El .env NUNCA se sube a git: ahí van las claves.
# Este .env.example SÍ se sube, para que otros sepan qué variables necesitan.

# Clave que Django usa para firmar. En un proyecto real, una larga y aleatoria.
SECRET_KEY=clave-de-ejemplo-solo-para-clases

# True mientras desarrollas. En un servidor de verdad va en False.
DEBUG=True

# Numero del taller para confirmar horas (sin +).
WHATSAPP_SALON=

# Contraseñas de las cuentas de prueba. Llenar solo en el .env local.
PASS_ADMIN=
PASS_NORMAL=
PASS_VIEWER=
PASS_CLIENTE=
